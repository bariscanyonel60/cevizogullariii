# Cloudinary — görsel yedekleme / admin upload
# Asla gerçek secret’ı commit etmeyin; .env.local kullanın.

CLOUDINARY_CLOUD_NAME=ymm7xvz0
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternatif tek satır formatı (opsiyonel):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@ymm7xvz0

# Site CDN olarak Cloudinary kullansın mı?
NEXT_PUBLIC_USE_CLOUDINARY=true
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ymm7xvz0

# Vercel Blob — galeri metadata (production’da zorunlu)
# Dashboard → Storage → Blob → BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# Yönetici paneli (/admin) — kullanıcı adı + şifre ile giriş
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Hostinger MySQL — muhasebe, galeri ve site içerikleri (ürün, blog, proje, SSS)
# Production (aynı Hostinger hesabı): DATABASE_HOST=127.0.0.1
# Yerel geliştirme: Uzaktan MySQL host (ör. srv1582.hstgr.io)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=u979100795_ceviz
DATABASE_USER=u979100795_ceviz
DATABASE_PASSWORD=

# Resend — iletişim / teklif formları
# Canlıda hPanel → Environment variables (GitHub’a yazmayın).
# Domain doğrulanmadan from adresi reddedilir; Resend’de cevizogullari.com ekleyin.
RESEND_API_KEY=
RESEND_FROM=Cevizogullari <info@cevizogullari.com>
MAIL_TO=info@cevizogullari.com
